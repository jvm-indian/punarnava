rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jvm.update@gmail.com' ||
        request.auth.token.email == 'siddharth@punarnava.org'
      );
    }

    // Users collection: citizens, kabadiwala partners, and admins
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Pickups collection: doorstep orders
    match /pickups/{pickupId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Reviews collection: citizen ratings and feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Collectors collection: verified ratings and profiles
    match /collectors/{collectorId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Scrap Rates: public read, admin update
    match /scrap_rates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

